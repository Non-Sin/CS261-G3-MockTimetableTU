# คัดลอกเป็น .env.local ถ้าต้องการเปลี่ยนค่า (ไม่จำเป็นสำหรับการพัฒนาปกติ)

# URL ของ backend ที่ Next.js rewrite /api/* ไปหา (ค่าเริ่มต้น http://localhost:8080)
# BACKEND_URL=http://localhost:8080

# ตั้งเมื่อต้องการให้ browser ยิงตรงไปที่ backend แทนการผ่าน rewrite
# NEXT_PUBLIC_API_URL=http://localhost:8080

# ตัวอย่างหน้า Login ของ US3 (ใช้บัญชีสมมติใน features/auth/README.md)
# เปิดเฉพาะตอน npm run dev; เมื่อไม่ตั้งค่านี้จะเรียก backend ตาม API Spec
# NEXT_PUBLIC_AUTH_MODE=mock
