# คัดลอกเป็น .env.local ถ้าต้องการเปลี่ยนค่า (ไม่จำเป็นสำหรับการพัฒนาปกติ)

# URL ของ backend ที่ Next.js rewrite /api/* ไปหา (ค่าเริ่มต้น http://localhost:8080)
# BACKEND_URL=http://localhost:8080

# ตั้งเมื่อต้องการให้ browser ยิงตรงไปที่ backend แทนการผ่าน rewrite
# NEXT_PUBLIC_API_URL=http://localhost:8080
