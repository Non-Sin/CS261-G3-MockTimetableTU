# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ไฟล์ .env ห้าม commit)
# รหัสต้องยาว >= 8 ตัว มีตัวพิมพ์ใหญ่ พิมพ์เล็ก ตัวเลข และสัญลักษณ์
MSSQL_SA_PASSWORD=Dev_Passw0rd_2026

# JWT ของ US3 login ต้องยาว >= 32 ตัวอักษร
JWT_SECRET=change-me-dev-secret-at-least-32-chars!!

# Application-Key จาก https://restapi.tu.ac.th (ไม่ต้องใส่ถ้ารันด้วย profile stub-tu)
TU_API_APPLICATION_KEY=

# docker compose: ใส่ stub-tu เพื่อใช้ TU API ปลอม (บัญชีทดสอบใน .doc/US3/T08) เว้นว่าง = TU API จริง
SPRING_PROFILES_ACTIVE=
