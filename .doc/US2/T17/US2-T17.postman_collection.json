    {
      "name": "01a Setup GET courses 2568/1 เก็บ sectionId",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 ได้ 9 วิชาของ 2568/1', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.have.lengthOf(9);",
              "});",
              "// เก็บเป็นตัวแปร sec_<รหัสวิชา>_<กลุ่ม> เช่น sec_CS111_030001 เพราะ sectionId เป็น IDENTITY ไม่คงที่",
              "pm.response.json().forEach((course) => course.sections.forEach((section) =>",
              "  pm.collectionVariables.set(`sec_${course.courseCode}_${section.sectionNo}`, section.sectionId)));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/courses?academicYear={{academicYear}}&semester=1"
      }
    },
