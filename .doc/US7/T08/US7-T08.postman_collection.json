{
  "info": {
    "name": "US7-T08 Quota API (test fixtures before T09)",
    "description": "Controller/Service/DTO/JWT tests using QuotaPostmanApplication. Data reader and timetable repositories are test fixtures, not SQL. Do not use real TU credentials. See README.md in this folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:18087"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenOther",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 REQUIRED - EL395",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/quota/courses?academicYear=2568&semester=1&q=EL395"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Course and status\", () => { pm.expect(body.courses[0].courseCode).to.eql(\"EL395\"); pm.expect(body.courses[0].quotaStatus).to.eql(\"REQUIRED\"); });",
              "pm.test(\"Related course\", () => { pm.expect(body.courses[0].conditions[0].relatedCourseCode).to.eql(\"EL295\"); });",
              "pm.test(\"Multiple channels and explicit nulls\", () => { pm.expect(body.courses[0].channels).to.have.length(2); pm.expect(body.courses[0].channels[1]).to.have.property(\"url\", null); pm.expect(body.courses[0].channels[0]).to.have.property(\"note\", null); });",
              "pm.test(\"ISO date and HH:mm\", () => { pm.expect(body.courses[0].rounds[0]).to.include({startDate:null,endDate:\"2025-08-20\",endTime:\"15:00\"}); });"
            ]
          }
        }
      ]
    },
