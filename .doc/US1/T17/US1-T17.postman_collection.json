    {
      "name": "04 Setup เพิ่มอีก 6 วิชาให้ครบ 21 หน่วยกิต (ชุดข้อมูล D)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// กลุ่มเรียนตาม UI Prototype (seed 2568/1)",
              "const sections = ['CS180_820001','MA211_020001','LAS101_780004','TU101_900001','TU106_540001','TU109_780001'];",
              "const addNext = (index) => {",
              "  if (index === sections.length) return;",
              "  pm.sendRequest({",
              "    url: `${pm.collectionVariables.get('baseUrl')}/api/timetable/entries`,",
              "    method: 'POST',",
              "    header: {",
              "      'Content-Type': 'application/json',",
              "      Authorization: `Bearer ${pm.collectionVariables.get('token')}`",
              "    },",
              "    body: { mode: 'raw', raw: JSON.stringify({ sectionId: Number(pm.collectionVariables.get(`sec_${sections[index]}`)) }) }",
              "  }, (err, res) => {",
              "    pm.test(`เพิ่ม ${sections[index]} ได้ 201`, () => {",
              "      pm.expect(err).to.eql(null);",
              "      pm.expect(res.code).to.eql(201);",
              "    });",
              "    addNext(index + 1);",
              "  });",
              "};",
              "addNext(0);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ตารางมี 7 วิชา 21 / 22 หน่วยกิต', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.entries.map((e) => e.courseCode).sort())",
              "    .to.eql(['CS111','CS180','LAS101','MA211','TU101','TU106','TU109']);",
              "  pm.expect(body.totalCredits).to.eql(21);",
              "  pm.expect(body.maxCredits).to.eql(22);",
              "});"
            ]
          }
        }
      ],
