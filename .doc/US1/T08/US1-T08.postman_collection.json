    {
      "name": "13 TC5 POST LAS101 (พุธ 09:30–12:30) ชนกับ TU109",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const t = pm.response.json();",
        "pm.test('201 (เวลาชนไม่ block ตาม Spec) พร้อม conflict 1 รายการ', () => {",
        "  pm.response.to.have.status(201);",
        "  pm.expect(t.conflicts).to.eql([{ dayOfWeek: 'WEDNESDAY', overlapStart: '09:30', overlapEnd: '12:30', courseCodes: ['TU109','LAS101'] }]);",
        "});",
        "pm.test('conflictWith ของ TU109 และ LAS101 ชี้หากัน', () => {",
        "  const byCode = Object.fromEntries(t.entries.map(e => [e.courseCode, e.conflictWith]));",
        "  pm.expect(byCode.TU109).to.eql(['LAS101']);",
        "  pm.expect(byCode.LAS101).to.eql(['TU109']);",
        "  pm.expect(byCode.CS111).to.eql([]);",
        "});"
      ] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
