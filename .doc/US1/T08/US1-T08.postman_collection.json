    {
      "name": "09 TC2 POST เพิ่ม CS111 Sec 030001",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const t = pm.response.json();",
        "pm.test('201 และตารางมี CS111', () => {",
        "  pm.response.to.have.status(201);",
        "  pm.expect(t.entries.map(e => e.courseCode)).to.eql(['CS111']);",
        "  pm.expect(t.entries[0].sectionNo).to.eql('030001');",
        "  pm.expect(t.totalCredits).to.eql(3);",
        "});",
        "pm.test('updatedAt เป็น ISO 8601 พร้อม offset ไม่มีเศษวินาที', () => {",
        "  pm.expect(t.updatedAt).to.match(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2}|Z)$/);",
        "});"
      ] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{ \"sectionId\": {{cs111_030001}} }" },
        "url": "{{baseUrl}}/api/timetable/entries" }
    },
    {
      "name": "10 TC3 GET ตาราง แสดงรหัส ชื่อ วัน เวลา ถูกต้อง",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('CS111 แสดงรหัส ชื่อ วันอังคาร/พฤหัส 11:00–12:30 ห้อง LC3-121', () => {",
        "  pm.response.to.have.status(200);",
        "  const e = pm.response.json().entries[0];",
        "  pm.expect(e.courseCode).to.eql('CS111');",
        "  pm.expect(e.courseName).to.eql('Object-Oriented Concepts');",
        "  pm.expect(e.schedules.map(x => x.dayOfWeek + ' ' + x.startTime + '-' + x.endTime + ' ' + x.room)).to.eql(['TUESDAY 11:00-12:30 LC3-121','THURSDAY 11:00-12:30 LC3-121']);",
        "  pm.expect(e.conflictWith).to.eql([]);",
        "});"
      ] } }],
