        "    TU109: 'WED 09:30-12:30',",
        "    LAS101: 'WED 09:30-12:30',",
        "    CS180: 'MON 13:30-16:30',",
        "    TU101: 'WED 13:30-16:30',",
        "    TU106: 'THU 13:30-16:30'",
        "  });",
        "});",
