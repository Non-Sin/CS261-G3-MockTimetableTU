{
  "info": {
    "name": "US1-T08 Mock Timetable API",
    "description": "ทดสอบ API ของ US1 ตาม US1-T05 DTO & API Spec และ Test case 1–8 ของการ์ด US1\n\nPreconditions:\n- backend รันที่ {{baseUrl}} ด้วย seed V20261014_2010 (2568/1)\n- นักศึกษา demo (app.timetable.demo-student-id) ยังไม่มีตารางภาค 2568/1 และ 2568/2\n\nต้องรันตามลำดับ (Run collection) เพราะแต่ละ request ใช้ผลของ request ก่อนหน้า",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "academicYear", "value": "2568" },
    { "key": "semester", "value": "1" }
  ],
  "item": [
    {
      "name": "00 Precondition: ตาราง 2568/1 ยังว่าง",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 และยังไม่มีวิชาในตาราง (ถ้าไม่ผ่าน ให้ล้างตารางของนักศึกษา demo ก่อน)', () => {",
        "  pm.response.to.have.status(200);",
        "  const t = pm.response.json();",
        "  pm.expect(t.entries).to.eql([]);",
        "  pm.expect(t.totalCredits).to.eql(0);",
        "  pm.expect(t.maxCredits).to.eql(22);",
        "  pm.expect(t.conflicts).to.eql([]);",
        "  pm.expect(t.updatedAt).to.eql(null);",
        "});"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/timetable?academicYear={{academicYear}}&semester={{semester}}" }
    },
    {
      "name": "01 TC1 GET /api/courses รายวิชาภาค 2568/1",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const courses = pm.response.json();",
        "pm.test('200 และได้ 9 วิชาเรียงตามรหัส (พบ 9 รายวิชา ตาม Figma)', () => {",
        "  pm.response.to.have.status(200);",
        "  pm.expect(courses.map(c => c.courseCode)).to.eql(['CS111','CS180','JP171','LAS101','MA211','ST216','TU101','TU106','TU109']);",
        "});",
        "pm.test('CS111 มี 2 กลุ่ม พร้อมคาบเรียนเรียงตามวัน เวลาเป็น HH:mm', () => {",
        "  const cs111 = courses.find(c => c.courseCode === 'CS111');",
        "  pm.expect(cs111.courseName).to.eql('Object-Oriented Concepts');",
        "  pm.expect(cs111.category).to.eql('MAJOR');",
        "  pm.expect(cs111.credits).to.eql(3);",
        "  pm.expect(cs111.sections.map(s => s.sectionNo)).to.eql(['030001','030002']);",
        "  const s1 = cs111.sections[0];",
        "  pm.expect(s1.instructor).to.eql('ผศ.ดร.สมชาย ใจดี');",
        "  pm.expect(s1.schedules.map(x => x.dayOfWeek + ' ' + x.startTime + '-' + x.endTime)).to.eql(['TUESDAY 11:00-12:30','THURSDAY 11:00-12:30']);",
        "});",
        "pm.test('MA211 Sec 020001 ห้อง SC-3015 ตาม UI Prototype', () => {",
        "  const ma211 = courses.find(c => c.courseCode === 'MA211').sections[0];",
        "  pm.expect(ma211.sectionNo).to.eql('020001');",
        "  pm.expect(ma211.schedules.map(x => x.room)).to.eql(['SC-3015','SC-3015']);",
        "});",
        "pm.test('ไม่มี CS223 ที่เปิดเฉพาะ 2568/2', () => {",
        "  pm.expect(courses.map(c => c.courseCode)).to.not.include('CS223');",
        "});",
        "const id = (code, no) => courses.find(c => c.courseCode === code).sections.find(s => s.sectionNo === no).sectionId;",
        "pm.collectionVariables.set('cs111_030001', id('CS111','030001'));",
        "pm.collectionVariables.set('cs111_030002', id('CS111','030002'));",
        "pm.collectionVariables.set('ma211', id('MA211','020001'));",
        "pm.collectionVariables.set('tu109', id('TU109','780001'));",
        "pm.collectionVariables.set('las101', id('LAS101','780004'));",
        "pm.collectionVariables.set('cs180', id('CS180','820001'));",
        "pm.collectionVariables.set('tu101', id('TU101','900001'));",
        "pm.collectionVariables.set('tu106', id('TU106','540001'));",
        "pm.collectionVariables.set('st216', id('ST216','040001'));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/courses?academicYear={{academicYear}}&semester={{semester}}" }
    },
