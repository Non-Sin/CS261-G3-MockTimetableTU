      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const t = pm.response.json();",
        "const slots = Object.fromEntries(t.entries.map(e => [e.courseCode, e.schedules.map(x => x.dayOfWeek.slice(0,3) + ' ' + x.startTime + '-' + x.endTime).join(', ')]));",
        "pm.test('ครบ 7 วิชาตาม UI Prototype 21 หน่วยกิต ตามลำดับที่เพิ่ม', () => {",
        "  pm.expect(t.entries.map(e => e.courseCode)).to.eql(['CS111','MA211','TU109','LAS101','CS180','TU101','TU106']);",
        "  pm.expect(t.totalCredits).to.eql(21);",
        "});",
        "pm.test('วันและเวลาของแต่ละวิชาตรงกับ UI Prototype', () => {",
        "  pm.expect(slots).to.eql({",
        "    CS111: 'TUE 11:00-12:30, THU 11:00-12:30',",
