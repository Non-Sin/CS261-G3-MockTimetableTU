{
  "info": {
    "name": "US3-T19 System Test (API)",
    "description": "ส่วนของ System Test US3-T15 ที่ทดสอบผ่าน API โดยตรง: ST-05/ST-06 (ล็อก 15 นาที และ 429 ขณะยังถูกระงับ), ST-10 (400/401) และ ST-11 (503 TU_API_UNAVAILABLE)\n\nPreconditions:\n- รันระบบด้วย docker compose และ SPRING_PROFILES_ACTIVE=stub-tu\n- รันคำสั่งล้าง DB ในเอกสาร US3-T15 ก่อน ({{lockUser}} และ {{unavailableUser}} ต้องไม่มีแถวใน login_attempt)\n\nต้องรันทั้ง collection ตามลำดับ เพราะ request บางตัววนซ้ำตัวเองด้วย setNextRequest",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "ST-10-1 POST login ไม่ส่ง username/password → 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 ProblemDetail มี errors ของ username และ password', () => {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  const errors = pm.response.json().errors;",
              "  pm.expect(errors).to.have.property('username');",
              "  pm.expect(errors).to.have.property('password');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": { "mode": "raw", "raw": "{\"username\": \"\", \"password\": \"\"}" }
      }
    },
    {
      "name": "ST-10-2 GET /api/users/me ไม่มี Authorization → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 จาก JwtAuthenticationFilter ไม่มีข้อมูลผู้ใช้', () => {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  pm.expect(pm.response.json()).to.not.have.property('studentId');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users/me"
      }
    },
    {
      "name": "ST-10-3 GET /api/users/me token ไม่ถูกต้อง → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 จาก JwtAuthenticationFilter ไม่มีข้อมูลผู้ใช้', () => {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  pm.expect(pm.response.json()).to.not.have.property('studentId');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer invalid.jwt.token" }],
        "url": "{{baseUrl}}/api/users/me"
      }
    },
    {
      "name": "ST-11 POST login TU API ใช้งานไม่ได้ ×5 → 503 ทุกครั้ง",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const round = Number(pm.collectionVariables.get('st11Round') || 1);",
              "pm.test(`ครั้งที่ ${round}: 503 TU_API_UNAVAILABLE ไม่นับ attempt (ไม่กลายเป็น 429)`, () => {",
              "  pm.response.to.have.status(503);",
              "  pm.expect(pm.response.json().code).to.eql('TU_API_UNAVAILABLE');",
              "});",
              "if (round < 5) {",
              "  pm.collectionVariables.set('st11Round', round + 1);",
              "  pm.execution.setNextRequest(pm.info.requestName);",
              "} else {",
              "  pm.collectionVariables.unset('st11Round');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": { "mode": "raw", "raw": "{\"username\": \"{{unavailableUser}}\", \"password\": \"{{password}}\"}" }
      }
    },
    {
      "name": "ST-05 POST login รหัสผิด ×5 → 401 ×4 แล้ว 429 (900 วินาที)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const round = Number(pm.collectionVariables.get('st05Round') || 1);",
              "const body = pm.response.json();",
              "if (round < 5) {",
              "  pm.test(`ครั้งที่ ${round}: 401 INVALID_CREDENTIALS`, () => {",
              "    pm.response.to.have.status(401);",
              "    pm.expect(body.code).to.eql('INVALID_CREDENTIALS');",
              "  });",
              "  pm.collectionVariables.set('st05Round', round + 1);",
              "  pm.execution.setNextRequest(pm.info.requestName);",
              "} else {",
              "  pm.test('ครั้งที่ 5: 429 ACCOUNT_LOCKED retryAfterSeconds 899–900', () => {",
              "    pm.response.to.have.status(429);",
              "    pm.expect(body.code).to.eql('ACCOUNT_LOCKED');",
              "    pm.expect(body.retryAfterSeconds).to.be.within(899, 900);",
              "  });",
              "  pm.collectionVariables.set('lockedRetryAfter', body.retryAfterSeconds);",
              "  pm.collectionVariables.unset('st05Round');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": { "mode": "raw", "raw": "{\"username\": \"{{lockUser}}\", \"password\": \"WrongPass1\"}" }
      }
    },
    {
      "name": "ST-06-1 POST login รหัสถูกขณะยังถูกระงับ → 429 เวลาที่เหลือลดลง",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// รอให้เวลาที่เหลือลดลงอย่างน้อย 3 วินาที",
              "setTimeout(() => {}, 3000);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('429 ACCOUNT_LOCKED ทันทีแม้รหัสผ่านถูก และ retryAfterSeconds ลดลง', () => {",
              "  pm.response.to.have.status(429);",
              "  const body = pm.response.json();",
              "  pm.expect(body.code).to.eql('ACCOUNT_LOCKED');",
              "  const before = Number(pm.collectionVariables.get('lockedRetryAfter'));",
              "  pm.expect(body.retryAfterSeconds).to.be.above(0);",
              "  pm.expect(body.retryAfterSeconds).to.be.below(before);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": { "mode": "raw", "raw": "{\"username\": \"{{lockUser}}\", \"password\": \"{{password}}\"}" }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "password", "value": "Passw0rd!" },
    { "key": "lockUser", "value": "6609000004" },
    { "key": "unavailableUser", "value": "6609000099" }
  ]
}
