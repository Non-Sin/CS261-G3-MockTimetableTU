    {
      "name": "05 GET /api/users/me token ถูกแก้ → 401",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// เปลี่ยนตัวอักษรท้ายลายเซ็น token จึงไม่ถูกต้อง",
              "const t = pm.collectionVariables.get('token');",
              "const last = t.slice(-1) === 'A' ? 'B' : 'A';",
              "pm.collectionVariables.set('tamperedToken', t.slice(0, -2) + last + last);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 ลายเซ็นไม่ตรง', () => {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  pm.expect(pm.response.json().detail).to.eql('กรุณาเข้าสู่ระบบก่อนใช้งาน');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tamperedToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/users/me"
      }
    },
    {
      "name": "06 TC5 รหัสผ่านผิด → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 ProblemDetail code INVALID_CREDENTIALS', () => {",
