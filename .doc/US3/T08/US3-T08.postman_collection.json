{
  "info": {
    "name": "US3-T08 Login API",
    "description": "ทดสอบ API ของ US3 ตาม US3-T05 DTO & API Spec และ Test case ของการ์ด US3\n\nPreconditions:\n- backend รันที่ {{baseUrl}} ด้วย profile stub-tu (StubTuApiClient แทน TU Login API จริง)\n- บัญชี {{lockUser}} ยังไม่ถูกล็อก (ไม่มีแถวใน login_attempt)\n\nต้องรันตามลำดับ (Run collection) เพราะ request 02–05 ใช้ token จาก request 01",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 GET /api/users/me ไม่มี token → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 ProblemDetail ให้กลับไป login', () => {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  pm.expect(pm.response.json().detail).to.eql('กรุณาเข้าสู่ระบบก่อนใช้งาน');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users/me"
      }
    },
    {
      "name": "01 TC1a POST login นักศึกษา CS ภาคปกติ active",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 ได้ token เป็น JWT', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(Object.keys(body)).to.eql(['token']);",
              "  pm.expect(body.token.split('.')).to.have.lengthOf(3);",
              "  pm.collectionVariables.set('token', body.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{csUser}}\", \"password\": \"{{password}}\"}"
        }
      }
    },
    {
      "name": "02 TC7 GET /api/users/me ด้วย token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 รหัสนักศึกษาและชื่อ-นามสกุลภาษาไทย แยกจาก displayname_th', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.eql({",
              "    studentId: pm.collectionVariables.get('csUser'),",
              "    firstName: 'สมชาย',",
              "    lastName: 'ใจดี'",
              "  });",
              "});"
            ]
          }
        }
