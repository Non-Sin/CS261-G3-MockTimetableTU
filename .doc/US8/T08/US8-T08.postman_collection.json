    {
      "name": "12 [IT-US8-07] POST dryRun แผนสหกิจปี 3/1 + วิชาโทวิทยาการข้อมูล → ได้ CS440 (MINOR)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('200 minorId ส่งกลับตาม request', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(body.minorId).to.eql(Number(pm.collectionVariables.get('minorDS')));",
              "});",
              "pm.test('CS440 อยู่ใน added เป็น source MINOR และวิชาของแผนหลักมาก่อนวิชาโท', () => {",
              "  const cs440 = body.added.find(a => a.courseCode === 'CS440');",
              "  pm.expect(cs440, 'CS440').to.exist;",
              "  pm.expect(cs440.source).to.eql('MINOR');",
              "  const sources = body.added.map(a => a.source);",
              "  pm.expect(sources.indexOf('MINOR')).to.be.above(sources.lastIndexOf('PLAN'));",
              "});"
            ]
          }
        }
      ],
