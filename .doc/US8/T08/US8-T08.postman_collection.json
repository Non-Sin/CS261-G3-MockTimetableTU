    {
      "name": "10 [IT-US8-06] POST dryRun แผนปี 2/1 ตารางว่าง → เพิ่มได้ทุกวิชา",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('200 dryRun: true, timetable: null, minorId: null (ส่ง null ใน JSON)', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(body.dryRun).to.eql(true);",
              "  pm.expect(body.planId).to.eql(Number(pm.collectionVariables.get('planY2S1')));",
              "  pm.expect(pm.response.text()).to.include('\"timetable\":null');",
              "  pm.expect(pm.response.text()).to.include('\"minorId\":null');",
              "});",
              "pm.test('ทุกวิชาของแผนอยู่ใน added พร้อม section และ source PLAN, skipped ว่าง', () => {",
              "  pm.expect(body.added).to.have.lengthOf(Number(pm.collectionVariables.get('planY2S1Count')));",
              "  body.added.forEach(a => {",
              "    pm.expect(a.source).to.eql('PLAN');",
              "    pm.expect(a.sectionId).to.be.a('number');",
              "    pm.expect(a.sectionNo).to.be.a('string');",
              "  });",
              "  pm.expect(body.skipped).to.eql([]);",
              "});"
            ]
          }
        }
