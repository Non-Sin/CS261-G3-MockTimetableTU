              "pm.test('200 added ว่าง ทุกวิชาเป็น COURSE_ALREADY_IN_TIMETABLE พร้อม existingSectionNo', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(body.added).to.eql([]);",
              "  pm.expect(body.skipped).to.have.lengthOf(Number(pm.collectionVariables.get('planY2S1Count')));",
              "  body.skipped.forEach(s => {",
              "    pm.expect(s.reason).to.eql('COURSE_ALREADY_IN_TIMETABLE');",
              "    pm.expect(s.message).to.eql(`${s.courseCode} อยู่ในตารางแล้ว (Sec ${s.existingSectionNo})`);",
              "  });",
              "});",
              "pm.test('added ว่างจึงไม่เขียน DB: entries เท่าเดิม และ updatedAt ไม่เปลี่ยน', () => {",
              "  pm.expect(body.timetable.entries).to.have.lengthOf(Number(pm.collectionVariables.get('planY2S1Count')));",
              "  pm.expect(body.timetable.updatedAt).to.eql(pm.collectionVariables.get('updatedAtAfterConfirm'));",
              "});"
