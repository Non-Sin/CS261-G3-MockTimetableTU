{
  "info": {
    "name": "US8-T08 Study Plan API",
    "description": "ทดสอบ GET /api/study-plans และ POST /api/timetable/apply-plan ตาม US8-T05 DTO & API Spec, US8-T06 Sequence Diagram และ IT ของ US8-T13 กับข้อมูล seed จริง (V20261114_2100__seed_study_plans.sql, V20261014_2010__seed_courses_2568_1.sql)\n\nPreconditions:\n- backend รันที่ {{baseUrl}} ด้วย profile stub-tu\n- บัญชี {{csUser}} เป็นนักศึกษา ภาควิชาวิทยาการคอมพิวเตอร์ ใน stub\n\nต้องรันตามลำดับ (Run collection) request 02–03 ล้างตาราง 2568/1 ของ {{csUser}} ก่อน และ 23–24 ล้างหลังจบ จึงรันซ้ำได้ planId / minorId อ่านจาก response ของ 04–05 ไม่ hard-code",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 GET /api/study-plans ไม่มี token → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 ProblemDetail (ทุก endpoint ของ US8 ต้อง login)', () => {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/study-plans?studyYear=2&semester=1"
      }
    },
    {
      "name": "01 POST login นักศึกษา CS (เตรียม token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 ได้ token เป็น JWT', () => {",
              "  pm.response.to.have.status(200);",
              "  const token = pm.response.json().token;",
              "  pm.expect(token.split('.')).to.have.lengthOf(3);",
              "  pm.collectionVariables.set('token', token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{csUser}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 [setup] GET ตาราง 2568/1 เก็บ entryId ที่ค้างจากรอบก่อน",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 อ่านตาราง 2568/1 ของ {{csUser}}', () => pm.response.to.have.status(200));",
              "const ids = pm.response.json().entries.map(e => e.entryId);",
              "pm.collectionVariables.set('entryIds', ids.join(','));",
              "pm.collectionVariables.set('updatedAtBefore', String(pm.response.json().updatedAt));",
              "// ไม่มีวิชาในตาราง → ข้าม request ลบ",
              "if (ids.length === 0) { postman.setNextRequest('04 [IT-US8-01] GET ชั้นปี 2 ภาค 1 → แผนเดียว planType null ไม่มีวิชาโท'); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/timetable?academicYear={{academicYear}}&semester=1"
      }
    },
    {
      "name": "03 [setup] DELETE วิชาที่ค้าง ให้ตารางว่างก่อนทดสอบ",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 ลบทุกวิชาแล้วตารางว่าง', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().entries).to.have.lengthOf(0);",
              "});",
              "pm.collectionVariables.set('updatedAtBefore', String(pm.response.json().updatedAt));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/timetable/entries?entryIds={{entryIds}}"
      }
    },
    {
      "name": "04 [IT-US8-01] GET ชั้นปี 2 ภาค 1 → แผนเดียว planType null ไม่มีวิชาโท",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('200 กรองด้วย department ของนักศึกษา + ชั้นปี/ภาคที่ส่ง', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(body.department).to.eql('ภาควิชาวิทยาการคอมพิวเตอร์');",
              "  pm.expect(body.studyYear).to.eql(2);",
              "  pm.expect(body.semester).to.eql(1);",
              "  pm.expect(body.plans).to.have.lengthOf(1);",
              "});",
              "pm.test('ส่ง \"planType\": null ใน JSON (ไม่ตัดทิ้ง) และ minors ว่าง', () => {",
              "  pm.expect(pm.response.text()).to.include('\"planType\":null');",
              "  pm.expect(body.minors).to.eql([]);",
              "});",
              "pm.test('totalCredits = ผลรวม credits ของ courses', () => {",
              "  const p = body.plans[0];",
              "  pm.expect(p.totalCredits).to.eql(p.courses.reduce((s, c) => s + c.credits, 0));",
              "  pm.expect(p.courses[0]).to.have.all.keys('courseCode', 'courseName', 'category', 'credits');",
              "});",
              "pm.collectionVariables.set('planY2S1', body.plans[0].planId);",
              "pm.collectionVariables.set('planY2S1Count', body.plans[0].courses.length);",
              "pm.collectionVariables.set('planY2S1Credits', body.plans[0].totalCredits);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/study-plans?studyYear=2&semester=1"
      }
    },
    {
      "name": "05 [IT-US8-02] GET ชั้นปี 3 ภาค 1 → 2 แผน และวิชาโทแยกตามแผน",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('200 ได้ทั้ง 2 แผน เรียง SPECIAL_PROJECT → CO_OP', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(body.plans.map(p => p.planType)).to.eql(['SPECIAL_PROJECT', 'CO_OP']);",
              "});",
              "pm.test('วิชาโท 1 รายการต่อ 1 วิชาโท × 1 แผน', () => {",
              "  body.minors.forEach(m => pm.expect(['SPECIAL_PROJECT', 'CO_OP']).to.include(m.planType));",
              "  const ds = body.minors.filter(m => m.minorName === 'วิทยาการข้อมูล');",
              "  pm.expect(ds.map(m => m.planType)).to.eql(['SPECIAL_PROJECT', 'CO_OP']);",
              "  pm.expect(ds[0].minorId).to.eql(ds[1].minorId);",
              "});",
              "pm.test('CS440 อยู่เฉพาะรายการ CO_OP ของวิชาโทวิทยาการข้อมูล (วิชาโทขึ้นกับแผน)', () => {",
              "  const ds = body.minors.filter(m => m.minorName === 'วิทยาการข้อมูล');",
              "  const codes = t => ds.find(m => m.planType === t).courses.map(c => c.courseCode);",
              "  pm.expect(codes('CO_OP')).to.include('CS440');",
              "  pm.expect(codes('SPECIAL_PROJECT')).to.not.include('CS440');",
              "  ds.forEach(m => pm.expect(m.totalCredits).to.eql(m.courses.reduce((s, c) => s + c.credits, 0)));",
              "});",
              "pm.collectionVariables.set('planY3S1SP', body.plans.find(p => p.planType === 'SPECIAL_PROJECT').planId);",
              "pm.collectionVariables.set('planY3S1CO', body.plans.find(p => p.planType === 'CO_OP').planId);",
              "pm.collectionVariables.set('minorDS', body.minors.find(m => m.minorName === 'วิทยาการข้อมูล').minorId);",
              "pm.collectionVariables.set('minorAI', body.minors.find(m => m.minorName === 'ปัญญาประดิษฐ์').minorId);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/study-plans?studyYear=3&semester=1"
