              "const body = pm.response.json();",
              "pm.test('200 ไม่ส่ง dryRun = false และคืน TimetableResponse ของ US1', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(body.dryRun).to.eql(false);",
              "  pm.expect(body.timetable).to.be.an('object');",
              "  pm.expect(body.timetable.academicYear).to.eql(Number(pm.collectionVariables.get('academicYear')));",
              "  pm.expect(body.timetable.semester).to.eql(1);",
              "  pm.expect(body.timetable.updatedAt).to.be.a('string');",
              "});",
              "pm.test('timetable มีทุกวิชาที่ added ตรง section และหน่วยกิตรวมถูกต้อง', () => {",
              "  const entries = body.timetable.entries;",
              "  pm.expect(entries).to.have.lengthOf(body.added.length);",
              "  body.added.forEach(a => pm.expect(entries.map(e => e.sectionId)).to.include(a.sectionId));",
              "  pm.expect(body.timetable.totalCredits).to.eql(Number(pm.collectionVariables.get('planY2S1Credits')));",
              "  pm.expect(body.timetable.conflicts).to.eql([]);",
              "});",
