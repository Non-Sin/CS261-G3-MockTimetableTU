    {
      "name": "22 [IT-US8-09][IT-US8-10][IT-US8-17] POST dryRun แผนหัวข้อพิเศษปี 3/1 + วิชาโท ทับตารางปี 2 → ชน / หน่วยกิตเกิน",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "const existing = Number(pm.collectionVariables.get('planY2S1Credits'));",
              "pm.test('200 มีวิชาที่ข้ามเพราะเวลาชน พร้อม conflictWith และ message', () => {",
              "  pm.response.to.have.status(200);",
              "  const conflicts = body.skipped.filter(s => s.reason === 'TIME_CONFLICT');",
              "  pm.expect(conflicts.length).to.be.above(0);",
              "  conflicts.forEach(s => {",
              "    pm.expect(s.conflictWith.length).to.be.above(0);",
              "    pm.expect(s.message).to.eql(`${s.courseCode} ทุกกลุ่มเรียนเวลาชนกับ ${s.conflictWith.join(', ')}`);",
              "    pm.expect(s).to.not.have.any.keys('existingSectionNo', 'currentCredits', 'maxCredits');",
              "  });",
              "});",
              "pm.test('มีวิชาที่ข้ามเพราะหน่วยกิตเกิน 22 พร้อม currentCredits / maxCredits', () => {",
              "  const added = body.added.reduce((s, a) => s + a.credits, 0);",
              "  const over = body.skipped.filter(s => s.reason === 'CREDIT_LIMIT_EXCEEDED');",
              "  pm.expect(over.length).to.be.above(0);",
              "  over.forEach(s => {",
              "    pm.expect(s.maxCredits).to.eql(22);",
              "    pm.expect(s.currentCredits).to.eql(existing + added);",
              "    pm.expect(s.currentCredits + s.credits).to.be.above(22);",
              "    pm.expect(s).to.not.have.property('conflictWith');",
              "  });",
              "});",
              "pm.test('วิชาที่เพิ่มไม่ทำให้หน่วยกิตรวมเกิน 22 และ timetable เป็น null', () => {",
              "  pm.expect(existing + body.added.reduce((s, a) => s + a.credits, 0)).to.be.at.most(22);",
              "  pm.expect(body.timetable).to.eql(null);",
              "});"
            ]
          }
        }
      ],
